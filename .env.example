# Vesta Backend — environment variables
# Reconstructed from os.getenv() calls in main.py
#
# Copy to .env and fill in the SECRET values (marked ← SECRET).
# Vars with a default shown only need setting if you're overriding it.

# --- Firebase / app ---------------------------------------------------------
# Either paste the whole service-account JSON on one line (used in production)...
FIREBASE_CREDENTIALS=                          # ← SECRET (full JSON string, one line)
# ...or point at a local key file instead (default: serviceAccountKey.json)
FIREBASE_CRED_PATH=serviceAccountKey.json
# Set to "production" to enable production mode (hides docs, etc.)
ENVIRONMENT=

# --- Ahli Bank (via FINX Comply) --------------------------------------------
AHLI_CLIENT_ID=                                # ← SECRET
AHLI_CLIENT_SECRET=                            # ← SECRET
FINX_INSTITUTION_APP_CODE=                     # ← SECRET (required by most Comply calls)
AHLI_REDIRECT_URI=                             # e.g. https://backend-vesta.onrender.com/banks/ahli/callback
VESTA_AHLI_SIGNING_KEY=                        # ← SECRET (RSA private key, PEM, for signing authorize-URL JWT)
# Defaults below are derived from COMPLY_HOST — only set to override
COMPLY_HOST=https://jo-comply.thefinx.io
# FINX_OPENID_CONFIG_URL=                      # default: {COMPLY_HOST}/.well-known/openid-configuration
# COMPLY_API_BASE=                             # default: {COMPLY_HOST}/api/public/jo/v0.4
# AHLI_AUTHORIZE_URL=                          # default: {COMPLY_HOST}/sandbox/{FINX_INSTITUTION_APP_CODE}/authorize

# --- Capital Bank (CBOJ) ----------------------------------------------------
CBOJ_CLIENT_ID=                                # ← SECRET
CBOJ_CLIENT_SECRET=                            # ← SECRET
CBOJ_REDIRECT_URI=
# Defaults below are derived from CBOJ_SANDBOX_HOST — only set to override
CBOJ_SANDBOX_HOST=https://sandbox.api.capitalbank.jo:8448
# CBOJ_API_BASE=                               # default: {CBOJ_SANDBOX_HOST}/ob/api/ais
# CBOJ_TOKEN_URL=                              # default: {CBOJ_SANDBOX_HOST}/ob/oauth2/token
# CBOJ_PSU_TOKEN_URL=                          # default: same as CBOJ_TOKEN_URL
# CBOJ_AUTHORIZE_URL=                          # default: {CBOJ_SANDBOX_HOST}/ob/web/login

# --- Bank al Etihad ---------------------------------------------------------
ETIHAD_CLIENT_ID=                              # ← SECRET
ETIHAD_CLIENT_SECRET=                          # ← SECRET
ETIHAD_IDENTITY_BASE=https://api.developer.bankaletihad.com/api/v1/tppa
ETIHAD_ACCOUNTS_BASE=https://api.developer.bankaletihad.com/api/v1/partner/accounts
# mTLS pair — both files are present in the repo root
ETIHAD_CERT_FILE=signedCert__314.crt
ETIHAD_KEY_FILE=server.key

# --- Housing Bank (HBTF) ----------------------------------------------------
HBTF_CLIENT_ID=                                # ← SECRET (portal → Client Credentials)
HBTF_CLIENT_SECRET=                            # ← SECRET (shown only once on creation)
# Token endpoint is on a different host than the data APIs
HBTF_API_BASE=https://sandbox.openbanking.hbtf.com
HBTF_OAUTH_BASE=https://oauth.openbanking.hbtf.com
HBTF_SCOPE=openid
# JAdES signing: private key stays local, cert comes back signed from the portal
HBTF_JADES_KEY_FILE=hbtf_jades_private.key
# HBTF_JADES_KEY_PEM=                          # ← SECRET, inline PEM instead of a file (use on Render)
HBTF_JADES_CERT_FILE=hbtf-jades-cert.pem
# HBTF_CERT_THUMBPRINT=                        # optional: skips reading the cert file
# Docs conflict on this; "false" matches HBTF's reference client. Flip if signatures are rejected.
HBTF_JADES_B64=false

# --- Server -----------------------------------------------------------------
# Render sets this automatically; local default is 10000
PORT=10000
